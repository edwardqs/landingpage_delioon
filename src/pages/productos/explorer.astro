---
// src/pages/productos/explorer.astro
import Layout from '../../layouts/BaseLayout.astro';

const features247 = [
    "Puede medir el impacto de los diseños de pervol en la cadena de valor",
    "Tiene un tiempo de análisis de 2min/foto",
    "Permite la visualización completa de la granulometría en polígonos de carguío",
    "Logra medir % de polución en el ambiente",
    "Disminuye sobrecostos en carguío y transporte de material",
    "Disminuye atascos, pérdidas de disponibilidad y reducción de capacidad de planta",
    "Tiene integración con el FMS de la mina"
];
const featuresPortable = [
    "Aplicación en minería superficial y subterránea",
    "Distancia de operación hasta 15 metros",
    "Autonomía de 2 horas",
    "Protección IP65",
    "No necesita escala ni referencia alguna",
    "No necesita internet para operar",
    "Plataforma web para edición y backup de datos"
];
---

<Layout 
  title="Producto - Explorer | Delion"
  showFooter={true}
  footerBackground={true}
  preloadImages={[
    '/images/product-explorer/Photo-1.svg',
    '/images/product-explorer/Photo-2.svg',
    '/images/product-explorer/Photo-3.svg',
    '/images/product-explorer/Image.svg',
    '/images/product-explorer/Image2.svg'
  ]}
>
  <main class="product-explorer-page">
    {/* SECCIÓN EXPLORER 24/7 CON LAYOUT ESPECIAL */}
    <section class="section-247-container pt-32 pb-16 pl-12">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        {/* Columna de texto */}
        <div class="text-content">
          <h1 class="product-title">Explorer 24/7</h1>
          <p class="product-subtitle">Medición autónoma de granulometría</p>
          <a href="/contacto" class="btn-cotizar-main">Cotizar</a>
          <ul class="feature-list mt-8">
            {features247.map(feature => (
              <li class="feature-item">
                <img src="/images/productos/Check square.svg" alt="Checklist icon" class="feature-icon" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
        
        {/* Columna de imagen */}
        <div id="image-carousel-container" class="image-carousel-container">
          <img src="/images/product-explorer/Photo-1.svg" alt="Vista de Explorer 1" class="carousel-image active" />
          <img src="/images/product-explorer/Photo-2.svg" alt="Vista de Explorer 2" class="carousel-image" />
          <img src="/images/product-explorer/Photo-3.svg" alt="Vista de Explorer 3" class="carousel-image" />
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    {/* SECCIÓN EXPLORER PORTABLE (SIN CAMBIOS) */}
    <section class="section-portable-container py-16">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            {/* Columna de imagen */}
            <div id="portable-carousel-container" class="image-content lg:order-1 portable-carousel-container">
                <img src="/images/product-explorer/Image.svg" alt="Reporte de Explorer Portable" class="carousel-image-portable full-bleed-img active" />
                <img src="/images/product-explorer/Image2.svg" alt="Detalle de granulometría" class="carousel-image-portable centered-img" />
            </div>
            {/* Columna de texto */}
            <div class="text-content text-content-right lg:order-2 pr-4 sm:pr-6 lg:pr-8">
                <h2 class="product-title">Explorer Portable</h2>
                <div class="portable-subtitle-group">
                    <div class="subtitle-wrapper">
                        <span class="product-subtitle-text">Cámara estéreo</span>
                        <img src="/images/productos/Icon-Binoculars.svg" alt="Icono de cámara estéreo" class="subtitle-icon" />
                    </div>
                    <div class="subtitle-wrapper">
                        <span class="product-subtitle-text">Drones</span>
                        <img src="/images/productos/Icon-Drone.svg" alt="Icono de drone" class="subtitle-icon" />
                    </div>
                </div>
                <a href="/contacto" class="btn-cotizar-main">Cotizar</a>
                {/* Este es el contenedor de features que estaba mal posicionado antes */}
                <ul class="feature-list feature-list-portable mt-8">
                    {featuresPortable.map(feature => (
                    <li class="feature-item">
                        <img src="/images/productos/Check square.svg" alt="Checklist icon" class="feature-icon" />
                        <span>{feature}</span>
                    </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>
  </main>
</Layout>

<style>
  @import '../../styles/pages/product-explorer.css';
</style>

<script>
  // El script no necesita cambios.
  document.addEventListener('DOMContentLoaded', () => {
    const carouselContainer247 = document.getElementById('image-carousel-container');
    if (carouselContainer247) {
      const images247 = carouselContainer247.querySelectorAll('.carousel-image');
      let currentIndex247 = 0;
      setInterval(() => {
        images247[currentIndex247].classList.remove('active');
        currentIndex247 = (currentIndex247 + 1) % images247.length;
        images247[currentIndex247].classList.add('active');
      }, 5000);
    }
    const carouselContainerPortable = document.getElementById('portable-carousel-container');
    if (carouselContainerPortable) {
      const imagesPortable = carouselContainerPortable.querySelectorAll('.carousel-image-portable');
      let currentIndexPortable = 0;
      setInterval(() => {
        imagesPortable[currentIndexPortable].classList.remove('active');
        currentIndexPortable = (currentIndexPortable + 1) % imagesPortable.length;
        imagesPortable[currentIndexPortable].classList.add('active');
      }, 5000);
    }
  });
</script>