---
import Layout from '../layouts/BaseLayout.astro';
import '../styles/cards.css';
---

<Layout 
  title="Delion - Página Principal" 
  showFooter={true}
  footerBackground={true}
  showLoader={true}
>
  <main>
    <section class="hero-section">
      <div class="hero-background">
        <img src="/images/Background-Home.png" alt="Fondo de Hero" class="hero-image" />
      </div>
      <div class="hero-inner">
        <div class="hero-content">
          <div class="hero-text">
            <div class="hero-title-container">
              <p class="hero-subtitle">Soluciones innovadoras y sostenibles<br>basadas en</p>
              <h1 class="hero-title">INTELIGENCIA ARTIFICIAL</h1>
            </div>
            <p class="hero-tagline">El arte de la ciencia</p>
          </div>
          <a href="/contacto" class="hero-button">Contácta al equipo</a>
        </div>
      </div>
      <!-- Robot posicionado de forma absoluta -->
      <div class="hero-robot">
        <img src="/Robot3D.png" alt="Robot 3D" class="robot-image" />
      </div>
    </section>

    <!-- Carrusel de imágenes -->
    <section class="carousel-section">
      <div class="carousel-container">
        <div class="carousel-track" id="carouselTrack">
          <!-- Slides originales -->
          <div class="carousel-slide">
            <img src="/images/images_carrusel/1.svg" alt="Imagen 1" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/2.svg" alt="Imagen 2" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/3.svg" alt="Imagen 3" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/4.svg" alt="Imagen 4" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/5.svg" alt="Imagen 5" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/6.svg" alt="Imagen 6" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/7.svg" alt="Imagen 7" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/8.svg" alt="Imagen 8" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/9.svg" alt="Imagen 9" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/10.svg" alt="Imagen 10" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/11.svg" alt="Imagen 11" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/12.svg" alt="Imagen 12" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/13.svg" alt="Imagen 13" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/14.svg" alt="Imagen 14" class="carousel-image" />
          </div>
          <!-- Slides duplicadas para efecto infinito -->
          <div class="carousel-slide">
            <img src="/images/images_carrusel/1.svg" alt="Imagen 1" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/2.svg" alt="Imagen 2" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/3.svg" alt="Imagen 3" class="carousel-image" />
          </div>
          <div class="carousel-slide">
            <img src="/images/images_carrusel/4.svg" alt="Imagen 4" class="carousel-image" />
          </div>
        </div>
      </div>
    </section>

    <!-- Sección Text-Hero-Quote -->
    <section class="text-hero-quote-section">
      <div class="text-hero-quote-container">
        <div class="quote-text-bold">Si no existe, lo creamos</div>
        <div class="quote-text-regular">y si existe, lo mejoramos</div>
      </div>
    </section>

    <!-- Sección Hero-Team -->
    <section class="hero-team">
      <div class="hero-team-background">
        <div class="team-degrade"></div>
      </div>
      <div class="hero-team-images">
        <div class="team-image team2"></div>
        <div class="team-image team1"></div>
        <div class="team-image team3"></div>
      </div>
    </section>

    <!-- Sección Nuestro Compromiso -->
    <section class="nuestro-compromiso">
        <h2>Nuestro compromiso</h2>
    </section>

    <!-- Sección de Cards -->
    <section class="cards-section">
      <div class="cards-container">
        <div class="card">
          <div class="title-card">
            <h3>Misión</h3>
          </div>
          <div class="icons-card">
            <div class="icon1"><img src="/images/compromiso/iconos_compromiso/Icon1.png" alt="Icono 1"></div>
          </div>
          <div class="content-card">
            <p>Brindar a nuestros<br>clientes soluciones<br>innovadoras para<br>contribuir al desarrollo<br>sostenible de la<br>empresa.</p>
          </div>
        </div>
        
        <div class="card">
          <div class="title-card">
            <h3>Visión</h3>
          </div>
          <div class="icons-card">
            <div class="icon2"><img src="/images/compromiso/iconos_compromiso/Icon2.png" alt="Icono 2"></div>
          </div>
          <div class="content-card">
            <p>Ser líderes en el desarrollo de herramientas<br>informáticas e<br>instrumentación<br>especializada.</p>
          </div>
        </div>
        
        <div class="card">
          <div class="title-card">
            <h3>Valores</h3>
          </div>
          <div class="icons-card">
            <div class="icon3"><img src="/images/compromiso/iconos_compromiso/Icon3.png" alt="Icono 3"></div>
          </div>
          <div class="content-card">
            <p>• Investigación e innovación<br>• Calidad en productos y servicios<br>• Servicio y atención durante el ciclo comercial<br>• Flexibilidad al cambio</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Iconos -->
    <section class="icons-section">
      <div class="icons-container">
        <div class="icon-item">
          <img src="/images/compromiso/iconos/Icon1.svg" alt="Identificar">
          <span class="icon-text">Identificar</span>
        </div>
        <div class="icon-item">
          <img src="/images/compromiso/iconos/Icon2.svg" alt="Medir">
          <span class="icon-text">Medir</span>
        </div>
        <div class="icon-item">
          <img src="/images/compromiso/iconos/Icon3.svg" alt="Analizar">
          <span class="icon-text">Analizar</span>
        </div>
        <div class="icon-item">
          <img src="/images/compromiso/iconos/Icon4.svg" alt="Resolver">
          <span class="icon-text">Resolver</span>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Estilos del Hero */
    .hero-section {
      position: relative;
      width: 100%;
      min-height: 100vh;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-background {
      position: absolute;
      top: -300px;
      left: 0;
      width: 100%;
      height: calc(100% + 300px);
      z-index: -1;
    }

    .hero-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center bottom;
    }

    .hero-inner {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2rem;
      min-height: 100vh;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 3rem;
      z-index: 3;
      max-width: 100%;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
    }

    .hero-title-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;
    }

    .hero-subtitle {
      font-family: 'Inter', sans-serif;
      font-weight: 300;
      font-size: clamp(1.25rem, 2.5vw, 2.5rem);
      line-height: 1.2;
      color: #FFFFFF;
      text-shadow: 0px 0px 100px #3D648D;
      margin: 0;
    }

    .hero-title {
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      line-height: 1.1;
      text-transform: uppercase;
      color: #FFFFFF;
      text-shadow: 0px -4px 4px rgba(255, 255, 255, 0.08), 
                   0px 4px 4px rgba(255, 255, 255, 0.08), 
                   0px 0px 100px #3D648D;
      margin: 0;
    }

    .hero-tagline {
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      font-size: clamp(1.5rem, 2.8vw, 2.5rem);
      line-height: 1.2;
      color: #FFFFFF;
      text-shadow: 0px 0px 50px #3D648D;
      margin: 0;
    }

    .hero-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 2.5rem;
      background: #D12407;
      color: #FFFFFF;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      text-decoration: none;
      border-radius: 0.75rem;
      box-shadow: 0px 0px 20px rgba(255, 255, 255, 0.08);
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
      white-space: nowrap;
    }

    .hero-button:hover {
      background: #B11E06;
      box-shadow: 0px 0px 25px rgba(255, 255, 255, 0.12);
      transform: translateY(-2px);
    }

    .hero-robot {
      position: absolute;
      top: 50%;
      right: 5%;
      transform: translateY(-50%);
      width: 40%;
      height: 80vh;
      z-index: 1;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .robot-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }

    /* Tablets grandes */
    @media (max-width: 1200px) {
      .hero-inner {
        max-width: 1200px;
        padding: 1.5rem;
      }

      .hero-robot {
        width: 38%;
        height: 75vh;
        right: 3%;
      }
    }

    /* Tablets medianas */
    @media (max-width: 1024px) {
      .hero-inner {
        grid-template-columns: 1.2fr 0.8fr;
        gap: 1rem;
      }

      .hero-robot {
        width: 35%;
        height: 70vh;
        right: 2%;
      }

      .hero-content {
        gap: 2.5rem;
      }
    }

    /* Tablets pequeñas */
    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 2rem 1rem;
        gap: 0;
      }

      .hero-content {
        align-items: center;
        z-index: 3;
        order: 1;
      }

      .hero-robot {
        position: absolute;
        top: 50%;
        left: 50%;
        right: auto;
        transform: translate(-50%, -50%);
        width: 60%;
        height: 60vh;
        opacity: 0.7;
        z-index: 1;
      }

      .hero-subtitle,
      .hero-title,
      .hero-tagline {
        text-align: center;
      }
    }

    /* Móviles grandes */
    @media (max-width: 768px) {
      .hero-inner {
        padding: 2rem 1rem;
        min-height: 100vh;
        align-items: flex-start;
        padding-top: 8rem;
      }

      .hero-content {
        gap: 2rem;
        width: 100%;
      }

      .hero-robot {
        width: 70%;
        height: 50vh;
        opacity: 0.6;
        top: 60%;
      }

      .hero-title {
        font-size: clamp(2rem, 8vw, 3rem);
      }
    }

    /* Móviles medianos */
    @media (max-width: 640px) {
      .hero-inner {
        padding: 1.5rem 1rem;
        padding-top: 6rem;
      }

      .hero-content {
        gap: 1.5rem;
      }

      .hero-robot {
        width: 75%;
        height: 45vh;
        opacity: 0.5;
      }

      .hero-button {
        padding: 0.875rem 2rem;
      }
    }

    /* Móviles pequeños */
    @media (max-width: 480px) {
      .hero-inner {
        padding: 1rem 0.5rem;
        padding-top: 5rem;
      }

      .hero-content {
        gap: 1.25rem;
      }

      .hero-text {
        gap: 1.5rem;
      }

      .hero-title-container {
        gap: 0.75rem;
      }

      .hero-robot {
        width: 80%;
        height: 40vh;
        opacity: 0.4;
        top: 65%;
      }

      .hero-button {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
      }
    }

    /* Móviles muy pequeños */
    @media (max-width: 360px) {
      .hero-inner {
        padding: 0.75rem 0.25rem;
        padding-top: 4rem;
      }

      .hero-content {
        gap: 1rem;
      }

      .hero-text {
        gap: 1rem;
      }

      .hero-title-container {
        gap: 0.5rem;
      }

      .hero-robot {
        width: 85%;
        height: 35vh;
        opacity: 0.35;
      }
    }

    /* Pantallas ultra anchas */
    @media (min-width: 1600px) {
      .hero-inner {
        max-width: 1600px;
      }

      .hero-robot {
        width: 45%;
        height: 85vh;
        right: 8%;
      }
    }

    /* Orientación landscape en móviles */
    @media (max-height: 600px) and (orientation: landscape) {
      .hero-section {
        min-height: 100vh;
      }

      .hero-inner {
        grid-template-columns: 1fr;
        padding-top: 2rem;
        min-height: 100vh;
      }

      .hero-robot {
        display: none;
      }

      .hero-content {
        justify-content: center;
        align-items: center;
        text-align: center;
      }
    }

    /* Pantallas muy altas */
    @media (min-height: 900px) {
      .robot-image {
        height: 110vh;
        transform: scale(1.25);
      }
    }

    /* Corrección para cambios dinámicos de ventana */
    @media (hover: hover) {
      .hero-button:hover {
        background: #B11E06;
        box-shadow: 0px 0px 25px rgba(255, 255, 255, 0.12);
        transform: translateY(-2px);
      }
    }

    /* Asegurar que el contenido no se desborde */
    .hero-section * {
      box-sizing: border-box;
    }

    /* Estilos de Text-Hero-Quote */
    .text-hero-quote-section {
      width: 100%;
      padding: clamp(0.5rem, 1vw, 1rem) 0;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .text-hero-quote-container {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      padding: 0px;
      gap: 160px;
      position: relative;
      width: min(974px, 90vw);
      height: auto;
    }

    .quote-text-bold {
      width: min(463px, 45vw);
      height: auto;
      font-family: 'Inter', sans-serif;
      font-style: normal;
      font-weight: 800;
      font-size: clamp(24px, 4vw, 40px);
      line-height: 150%;
      display: flex;
      align-items: center;
      color: #0C3D71;
      flex: none;
      order: 0;
      flex-grow: 0;
      white-space: nowrap;
    }

    .quote-text-regular {
      width: min(463px, 45vw);
      height: auto;
      font-family: 'Inter', sans-serif;
      font-style: normal;
      font-weight: 400;
      font-size: clamp(24px, 4vw, 40px);
      line-height: 150%;
      display: flex;
      align-items: center;
      color: #0C3D71;
      flex: none;
      order: 1;
      flex-grow: 0;
      white-space: nowrap;
    }

    /* Responsive para Text-Hero-Quote */
    @media (max-width: 768px) {
      .text-hero-quote-container {
        flex-direction: column;
        gap: 24px;
        text-align: center;
      }
      
      .quote-text-bold,
      .quote-text-regular {
        width: 90vw;
      }
    }

    /* Estilos de Hero-Team */
    .hero-team {
      position: relative;
      width: 100%;
      height: 285px;
      margin-top: 2rem;
    }

    .hero-team-background {
      position: absolute;
      left: 0%;
      right: 0%;
      top: 18.25%;
      bottom: 18.25%;
    }

    .team-degrade {
      position: absolute;
      left: 0%;
      right: 0%;
      top: 0%;
      bottom: 0%;
      background: linear-gradient(90deg, #D3290A 0%, #0C3D71 100%);
    }

    .hero-team-images {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      padding: 0px;
      gap: 100px;
      position: absolute;
      left: 9.61%;
      right: 9.61%;
      top: 0%;
      bottom: 0%;
    }

    .team-image {
      box-sizing: border-box;
      border: 0.5px solid rgba(5, 21, 38, 0.5);
      border-radius: 8px;
      flex: none;
      flex-grow: 0;
    }

    .team2 {
      width: 187px;
      height: 249px;
      background: url('/images/images_equipo_index/team2.jpg') center/cover;
      box-shadow: 0px 0px 24px rgba(5, 21, 38, 0.5);
      order: 0;
    }

    .team1 {
      width: 459px;
      height: 285px;
      background: url('/images/images_equipo_index/team1.png') center/cover;
      filter: drop-shadow(0px 0px 28px rgba(5, 21, 38, 0.5));
      order: 1;
    }

    .team3 {
      width: 187px;
      height: 249px;
      background: url('/images/images_equipo_index/team0.jpg') center/cover;
      box-shadow: 0px 0px 24px rgba(5, 21, 38, 0.5);
      order: 2;
    }

    /* Responsive para Hero-Team */
    @media (max-width: 1024px) {
      .hero-team-images {
        gap: 50px;
        left: 5%;
        right: 5%;
      }
      
      .team1 {
        width: 350px;
        height: 220px;
      }
      
      .team2, .team3 {
        width: 140px;
        height: 190px;
      }
    }

    @media (max-width: 768px) {
      .hero-team {
        height: 200px;
      }
      
      .hero-team-images {
        gap: 20px;
        left: 2%;
        right: 2%;
      }
      
      .team1 {
        width: 250px;
        height: 160px;
      }
      
      .team2, .team3 {
        width: 100px;
        height: 130px;
      }
    }

    @media (max-width: 480px) {
      .hero-team {
        height: 150px;
      }
      
      .hero-team-images {
        gap: 10px;
        flex-direction: row;
      }
      
      .team1 {
        width: 180px;
        height: 120px;
      }
      
      .team2, .team3 {
        width: 70px;
        height: 90px;
      }
    }

    /* Nuestro compromiso */
    .nuestro-compromiso {
      position: relative;
      width: 100%;
      padding: 2rem 0;
      background: transparent;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    
    .nuestro-compromiso h2 {
      /* Title */
      position: relative;
      width: 410px;
      height: 60px;
      font-family: 'Inter', sans-serif;
      font-style: normal;
      font-weight: 700;
      font-size: 40px;
      line-height: 150%;
      /* idéntica a la altura del cuadro o 60px */
      display: flex;
      align-items: center;
      color: #0C3D71;
      margin: 0;
    }





    /* Estilos del Carrusel Mejorado */
  .carousel-section {
    width: 100%;
    padding: clamp(0.5rem, 2vw, 1rem) 0;
    background: transparent;
    position: relative;
    overflow: hidden;
  }

  .carousel-container {
    position: relative;
    width: 100vw;
    margin: 0;
    overflow: hidden;
    height: clamp(150px, 25vw, 300px);
    display: flex;
    align-items: center;
  }

  .carousel-track {
    display: flex;
    animation: scroll-infinite 30s linear infinite;
    width: fit-content;
  }

  .carousel-slide {
    flex-shrink: 0;
    width: clamp(150px, 20vw, 250px);
    height: clamp(120px, 18vw, 200px);
    margin-right: clamp(1rem, 3vw, 2rem);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .carousel-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.3));
    transition: transform 0.3s ease;
    border-radius: 8px;
  }

  .carousel-image:hover {
    transform: scale(1.05);
  }

  /* Pausa la animación al hacer hover sobre el carrusel */
  .carousel-container:hover .carousel-track {
    animation-play-state: paused;
  }

  /* Animación de scroll infinito */
  @keyframes scroll-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-1 * (clamp(150px, 20vw, 250px) + clamp(1rem, 3vw, 2rem)) * 14));
    }
  }

  /* Responsive del carrusel */
  @media (max-width: 768px) {
    .carousel-section {
      padding: clamp(1.5rem, 4vw, 2.5rem) 0;
    }

    .carousel-container {
      width: 100vw;
      height: clamp(120px, 20vw, 200px);
    }

    .carousel-slide {
      width: clamp(120px, 18vw, 180px);
      height: clamp(100px, 15vw, 150px);
      margin-right: clamp(0.5rem, 2vw, 1rem);
    }

    @keyframes scroll-infinite {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-1 * (clamp(120px, 18vw, 180px) + clamp(0.5rem, 2vw, 1rem)) * 14));
      }
    }
  }

  @media (max-width: 480px) {
    .carousel-container {
      height: clamp(100px, 18vw, 160px);
    }

    .carousel-slide {
      width: clamp(100px, 16vw, 140px);
      height: clamp(80px, 13vw, 120px);
    }

    .carousel-track {
      animation-duration: 25s;
    }
  }

  /* Mejora del rendimiento */
  .carousel-track {
    will-change: transform;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .carousel-image {
    will-change: transform;
    transform: translateZ(0);
  }

  /* Estilos de la Sección de Iconos */
  .icons-section {
    width: 100%;
    padding: 4rem 0;
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
