<script>
  // El carrusel ahora funciona completamente con CSS animations
  // No necesita JavaScript para el scroll automático
  
  document.addEventListener('DOMContentLoaded', function() {
    // Opcional: agregar interactividad adicional si es necesaria
    const track = document.querySelector('.carousel-track');
    const container = document.querySelector('.carousel-container');
    
    // Función para pausar/reanudar la animación en dispositivos móviles al tocar
    let isPaused = false;
    
    if (container) {
      container.addEventListener('touchstart', function() {
        if (!isPaused) {
          if (track instanceof HTMLElement) track.style.animationPlayState = 'paused';
          isPaused = true;
        }
      });
      
      container.addEventListener('touchend', function() {
        setTimeout(() => {
          if (isPaused) {
            if (track instanceof HTMLElement) track.style.animationPlayState = 'running';
            isPaused = false;
          }
        }, 1000); // Pausa de 1 segundo antes de reanudar
      });
    }
  });
</script>