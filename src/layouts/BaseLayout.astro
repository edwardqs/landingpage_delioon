---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/main.css';

interface Props {
  title: string;
  showFooter?: boolean;                 // ya lo tenías
  footerBackground?: boolean;           // NUEVO: pone Background-Footer.svg detrás del footer
  footerTheme?: 'light' | 'dark';       // NUEVO: tema de texto del footer
  showLoader?: boolean;                 // NUEVO: mostrar loader global
  loaderType?: 'full' | 'minimal';      // NUEVO: tipo de loader
  preloadImages?: string[];             // NUEVO: imágenes específicas a precargar
  bodyClass?: string;                   // NUEVO: clase CSS para el body
}

const {
  title,
  showFooter = true,
  footerBackground = false,
  footerTheme = footerBackground ? 'light' : 'dark',
  showLoader = false,
  loaderType = 'full',
  preloadImages = [],
  bodyClass = '',
} = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <meta name="description" content="Delion - Soluciones innovadoras y sostenibles para potenciar tu negocio con tecnología de vanguardia." />
  <meta name="keywords" content="Delion, tecnología, innovación, soluciones, minería, software, hardware" />
  <meta name="author" content="Delion Perú" />

  <link rel="preload" href="/Logo-Delion-Color.svg" as="image" type="image/svg+xml" />

  <link rel="dns-prefetch" href="//wa.me" />
  <link rel="preconnect" href="https://wa.me" crossorigin />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content="Delion - El Arte de la Ciencia" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.toString()} />
  <meta property="og:image" content="/social-preview.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content="Delion - El Arte de la Ciencia" />
  <meta name="twitter:image" content="/social-preview.jpg" />

  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="format-detection" content="telephone=no" />
  <meta name="theme-color" content="#FFFFFF" />
  <meta name="color-scheme" content="light" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Montserrat:wght@500;700&family=Play:wght@400;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700&display=swap" rel="stylesheet" />
  


  <style is:inline>
    :root { 
      --font-sans: 'Montserrat', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-display: 'Play', sans-serif;
      --navbar-height: 80px;
    }
    body {
      margin: 0;
      font-family: var(--font-sans);
      text-rendering: optimizeSpeed;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      background-color: #f8fafc;
    }
    html { scroll-behavior: smooth; }
    * { box-sizing: border-box; }

    header {
      position: absolute; top: 0; left: 0; width: 100%; z-index: 50;
    }
    header nav {
      background-color: rgba(10, 25, 47, 0.9);
      backdrop-filter: blur(5px);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1);
      border-bottom-left-radius: 1rem;
      border-bottom-right-radius: 1rem;
      overflow: hidden;
    }

    /* utilitario para secciones a ancho completo (sin bordes blancos) */
    .full-bleed { width: 100vw; margin-left: 50%; transform: translateX(-50%); }

    #whatsapp-button {
      opacity: 0; transform: translateY(20px);
      transition: opacity .6s ease-out, transform .6s ease-out;
      will-change: transform, opacity;
    }
    #whatsapp-button.visible { opacity: 1; transform: translateY(0); }
    #whatsapp-button:hover { transform: scale(1.05); }
    @media (max-width: 768px) {
      #whatsapp-button { bottom: 1rem; right: 1rem; width: 3.5rem; height: 3.5rem; }
      #whatsapp-button svg { width: 24px; height: 24px; }
    }

    /* Loader Animations */
    .loader-container {
      position: relative;
      display: inline-block;
    }

    .loader-logo {
      width: 7.5rem;
      height: 7.5rem;
      position: relative;
      z-index: 2;
      animation: logoFloat 3s ease-in-out infinite;
      filter: drop-shadow(0 0.25rem 0.5rem rgba(12, 61, 113, 0.2));
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
    }

    .loader-pulse {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 9rem;
      height: 9rem;
      background: radial-gradient(circle, rgba(12, 61, 113, 0.1) 0%, transparent 70%);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      animation: pulse 2s ease-in-out infinite;
      z-index: 1;
    }

    .loader-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 10rem;
      height: 10rem;
      border: 0.125rem solid transparent;
      border-top: 0.125rem solid #DE1207;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      animation: rotate 1.5s linear infinite;
      z-index: 0;
    }

    .loader-text {
      animation: textGlow 2s ease-in-out infinite alternate;
    }

    .loader-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
    }

    .loader-dots span {
      width: 8px;
      height: 8px;
      background: #DE1207;
      border-radius: 50%;
      animation: dotBounce 1.4s ease-in-out infinite both;
    }

    .loader-dots span:nth-child(1) { animation-delay: -0.32s; }
    .loader-dots span:nth-child(2) { animation-delay: -0.16s; }
    .loader-dots span:nth-child(3) { animation-delay: 0s; }

    .loader-progress {
      animation: progressShimmer 2s ease-in-out infinite;
    }

    @keyframes logoFloat {
      0%, 100% { transform: translateY(0px) scale(1); }
      50% { transform: translateY(-10px) scale(1.05); }
    }

    @keyframes pulse {
      0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
      50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.3; }
    }

    @keyframes rotate {
      0% { transform: translate(-50%, -50%) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg); }
    }

    @keyframes textGlow {
      0% { text-shadow: 0 0 5px rgba(12, 61, 113, 0.3); }
      100% { text-shadow: 0 0 20px rgba(12, 61, 113, 0.6), 0 0 30px rgba(222, 18, 7, 0.3); }
    }

    @keyframes dotBounce {
      0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
      40% { transform: scale(1.2); opacity: 1; }
    }

    @keyframes progressShimmer {
      0% { background-position: -200px 0; }
      100% { background-position: 200px 0; }
    }

    /* Responsive adjustments for loader */
    @media (max-width: 768px) {
      .loader-logo { width: 5rem; height: 5rem; }
      .loader-pulse { width: 6.25rem; height: 6.25rem; }
      .loader-ring { width: 7.5rem; height: 7.5rem; }
      .loader-text { font-size: 1rem; }
    }
  </style>
</head>
<body class={bodyClass}>
  {showLoader && (
    <div id="global-loader" class="fixed inset-0 bg-gradient-to-br from-white via-gray-50 to-blue-50 z-[9999] flex items-center justify-center opacity-100 transition-opacity duration-500">
      <div class="text-center">
        <div class="loader-container mb-6">
          <img 
            src="/ISOLOGO.png" 
            alt="Delion Logo" 
            class="loader-logo mx-auto"
            width="120" 
            height="120"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
          <div class="loader-pulse"></div>
          <div class="loader-ring"></div>
        </div>
        <p class="text-[#0C3D71] font-play font-semibold text-xl mb-2 loader-text">
          {loaderType === 'full' ? 'Cargando experiencia...' : 'Cargando...'}
        </p>
        <div class="loader-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
        {loaderType === 'full' && (
          <div class="mt-4 bg-gray-200 rounded-full h-2 w-64 mx-auto overflow-hidden">
            <div id="loading-progress" class="bg-gradient-to-r from-[#DE1207] to-[#FF4444] h-2 rounded-full transition-all duration-300 loader-progress" style="width: 0%"></div>
          </div>
        )}
      </div>
    </div>
  )}
  <header id="main-header">
    <Navbar />
  </header>

  <main id="main-content" style={showLoader ? "opacity: 0; transition: opacity 0.5s ease-in-out;" : ""}>
    <slot />
  </main>

  {showFooter && (
    <Footer theme={footerTheme} showCarousel={Astro.url.pathname === '/'} showBackground={footerBackground} />
  )}

  <div id="whatsapp-button" class="fixed bottom-6 right-6 z-50 group">
    <div class="absolute bottom-full right-0 mb-3 px-3 py-2 bg-gray-900 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pointer-events-none">
      ¡Chatea con nosotros!
      <div class="absolute top-full right-4 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-900"></div>
    </div>
    <a 
      href="https://wa.me/51913851514?text=Hola%20Delion,%20me%20gustar%C3%ADa%20obtener%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20productos%20y%20servicios."
      target="_blank" rel="noopener noreferrer"
      class="flex items-center justify-center w-16 h-16 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-lg transition-transform duration-300"
      aria-label="Contactar por WhatsApp" title="Contactar por WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/></svg>
    </a>
  </div>

  {showLoader && (
    <script is:inline define:vars={{ preloadImages, loaderType }}>
      // Sistema de carga global
      class GlobalImagePreloader {
        constructor(images = [], type = 'full') {
          this.images = images.length > 0 ? images : this.getDefaultImages();
          this.loadedCount = 0;
          this.totalImages = this.images.length;
          this.loaderType = type;
          this.progressBar = document.getElementById('loading-progress');
          this.loader = document.getElementById('global-loader');
          this.mainContent = document.getElementById('main-content');
        }

        getDefaultImages() {
          return [
            '/Logo-Delion-Color.svg',
            '/Background-Hero.svg',
            '/ISOLOGO.png'
          ];
        }

        preloadImages() {
          return new Promise((resolve) => {
            if (this.images.length === 0) {
              // Incluso sin imágenes, mantener un delay mínimo
              setTimeout(() => {
                resolve();
              }, 1000);
              return;
            }

            // Precargar el ISOLOGO con máxima prioridad
            const loaderLogo = new Image();
            loaderLogo.loading = 'eager';
            loaderLogo.decoding = 'sync';
            loaderLogo.fetchPriority = 'high';
            loaderLogo.src = '/ISOLOGO.png';
            
            this.images.forEach((src, index) => {
              const img = new Image();
              
              img.onload = () => {
                this.loadedCount++;
                this.updateProgress();
                console.log(`Imagen cargada: ${src} (${this.loadedCount}/${this.totalImages})`);
                
                if (this.loadedCount === this.totalImages) {
                  // Delay adicional para asegurar que todas las imágenes estén completamente renderizadas
                  setTimeout(() => {
                    console.log('Todas las imágenes cargadas, mostrando contenido');
                    resolve();
                  }, 500);
                }
              };
              
              img.onerror = () => {
                console.warn(`Error cargando imagen: ${src}`);
                this.loadedCount++;
                this.updateProgress();
                
                if (this.loadedCount === this.totalImages) {
                  setTimeout(() => {
                    resolve();
                  }, 500);
                }
              };
              
              setTimeout(() => {
                img.src = src;
              }, index * (this.loaderType === 'full' ? 100 : 50));
            });
          });
        }

        updateProgress() {
          if (this.loaderType === 'full' && this.progressBar) {
            const percentage = (this.loadedCount / this.totalImages) * 100;
            this.progressBar.style.width = `${percentage}%`;
          }
        }

        showContent() {
          console.log('Iniciando transición para ocultar loader');
          if (this.loader) {
            this.loader.style.opacity = '0';
            setTimeout(() => {
              this.loader.style.display = 'none';
              console.log('Loader ocultado completamente');
            }, 500);
          }
          
          if (this.mainContent) {
            setTimeout(() => {
              this.mainContent.style.opacity = '1';
              console.log('Contenido principal mostrado');
            }, 250);
          }
        }
      }

      // Inicializar sistema de carga
      document.addEventListener('DOMContentLoaded', async () => {
        console.log('Iniciando sistema de carga');
        const preloader = new GlobalImagePreloader(preloadImages, loaderType);
        
        // Detectar si es móvil
        const isMobile = window.innerWidth <= 768 || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        console.log('Dispositivo móvil detectado:', isMobile);
        
        // Delay mínimo más largo para asegurar visibilidad
        const minDelay = isMobile ? 1500 : 1000;
        const startTime = Date.now();
        
        try {
          console.log('Iniciando precarga de imágenes...');
          await preloader.preloadImages();
          console.log('Precarga completada');
          
          // Asegurar delay mínimo especialmente en móvil
          const elapsedTime = Date.now() - startTime;
          const remainingDelay = Math.max(0, minDelay - elapsedTime);
          
          console.log(`Tiempo transcurrido: ${elapsedTime}ms, delay restante: ${remainingDelay}ms`);
          
          setTimeout(() => {
            preloader.showContent();
          }, remainingDelay);
          
        } catch (error) {
          console.error('Error en la precarga global:', error);
          
          // Incluso con error, mantener delay mínimo en móvil
          const elapsedTime = Date.now() - startTime;
          const remainingDelay = Math.max(0, minDelay - elapsedTime);
          
          setTimeout(() => {
            preloader.showContent();
          }, remainingDelay);
        }
      });
    </script>
  )}

  <script is:inline>
    (function () {
      'use strict';
      function initWhatsAppButton() {
        const el = document.getElementById('whatsapp-button');
        if (!el) return;
        setTimeout(() => { el.classList.add('visible'); }, 1500);
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWhatsAppButton);
      } else {
        initWhatsAppButton();
      }
    })();
  </script>
</body>
</html>
